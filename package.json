{
  "name": "adpm",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic Data Product Management — supervised-autonomy lifecycle management for data products.",
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "node scripts/prepare-postgres.js && prisma db push --accept-data-loss && tsx prisma/seed.ts",
    "db:reset": "node -e \"require('node:fs').rmSync('prisma/dev.db', { force: true })\" && pnpm db:seed",
    "db:pg:prepare": "tsx scripts/prepare-postgres.ts",
    "db:pg:setup": "pnpm db:pg:prepare && prisma db push --schema prisma/schema.postgres.prisma --skip-generate --accept-data-loss && prisma generate --schema prisma/schema.postgres.prisma",
    "db:seed:pg": "pnpm db:pg:setup && tsx prisma/seed.ts",
    "monitor": "tsx scripts/monitor.ts",
    "pack:validate": "tsx scripts/validate-packs.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "postinstall": "node scripts/ensure-env.mjs && node scripts/prepare-postgres.js && npx prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "mermaid": "^11.16.0",
    "next": "15.5.22",
    "next-auth": "5.0.0-beta.32",
    "pdf-lib": "^1.17.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "eslint": "^9.29.0",
    "eslint-config-next": "15.5.22",
    "netlify-cli": "^27.1.2",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.11"
  }
}
